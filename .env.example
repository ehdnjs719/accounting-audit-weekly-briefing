# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# --- 메일 (네이버 SMTP) ---
# 네이버 메일 > 환경설정 > POP3/IMAP 설정 > 'POP3/SMTP 사용' 을 켜야 합니다.
# 2단계 인증을 쓰면 '애플리케이션 비밀번호'를 발급해 넣으세요.
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=네이버아이디
SMTP_PASSWORD=
MAIL_FROM=네이버아이디@naver.com
MAIL_TO=받을주소@naver.com

# --- Claude API (선택) ---
# 없으면 규칙 기반 요약으로 동작합니다. https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# --- 출력 폴더 (선택, config.yaml 보다 우선) ---
# OUTPUT_DIR=C:\Users\사용자명\Documents\CPA_Weekly_Briefing
