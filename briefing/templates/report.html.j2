<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
  :root { --ink:#16213a; --muted:#5d6b82; --line:#e3e8f0; --accent:#1f4fd1; --accent-soft:#eef3ff;
          --warn:#b45309; --warn-soft:#fff7ed; --s1:#1f4fd1; --s2:#0f8a6a; --s3:#7c3aed; }
  * { box-sizing:border-box; }
  html, body { margin:0; background:#fff; color:var(--ink);
    font-family:"Noto Sans KR","Malgun Gothic","Apple SD Gothic Neo","Noto Sans CJK KR","NanumGothic",sans-serif;
    font-size:10.2pt; line-height:1.62; word-break:keep-all; -webkit-print-color-adjust:exact; }
  a { color:var(--accent); text-decoration:none; }
  .cover { border-radius:14px; padding:18px 18px 16px; color:#fff;
    background:linear-gradient(135deg,#102a6b 0%,#1f4fd1 70%,#3b82f6 100%); }
  .cover .kicker { font-size:8pt; letter-spacing:.12em; opacity:.85; font-weight:700; }
  .cover h1 { margin:4px 0 6px; font-size:17pt; line-height:1.3; font-weight:800; }
  .cover .period { font-size:9pt; opacity:.92; }
  .stats { display:flex; gap:6px; margin-top:12px; }
  .stat { flex:1; background:rgba(255,255,255,.14); border-radius:9px; padding:6px 8px; }
  .stat b { display:block; font-size:13pt; line-height:1.2; }
  .stat span { font-size:7.4pt; opacity:.9; }
  h2.sec { margin:22px 0 10px; font-size:12.5pt; font-weight:800; display:flex; align-items:center; gap:8px;
    break-after:avoid; }
  h2.sec .no { color:#fff; border-radius:6px; padding:1px 8px; font-size:9pt; }
  .top3 .card { border:1px solid var(--line); border-left:5px solid var(--accent); border-radius:10px;
    padding:10px 12px; margin-bottom:9px; break-inside:avoid; background:var(--accent-soft); }
  .top3 .rank { font-size:8pt; font-weight:800; color:var(--accent); letter-spacing:.06em; }
  .top3 .headline { font-size:11.2pt; font-weight:800; margin:2px 0 4px; line-height:1.4; }
  .top3 .brief { font-size:9.4pt; color:#2b3852; }
  .top3 .src { font-size:8pt; color:var(--muted); margin-top:5px; }
  .item { border-bottom:1px solid var(--line); padding:11px 0 12px; break-inside:avoid; }
  .item:last-child { border-bottom:none; }
  .item .meta { font-size:7.8pt; color:var(--muted); margin-bottom:2px; }
  .tag { display:inline-block; border-radius:5px; padding:0 6px; font-size:7.4pt; font-weight:700;
    background:#f1f4f9; color:#41506b; margin-right:3px; }
  .item h3 { margin:0 0 5px; font-size:10.8pt; line-height:1.45; font-weight:700; }
  .item h3 a { color:var(--ink); }
  .item ul { margin:0 0 6px; padding-left:16px; }
  .item li { margin:1px 0; font-size:9.4pt; }
  .impl { background:#f6f8fb; border-radius:8px; padding:6px 9px; font-size:9pt; color:#2b3852; }
  .impl b { color:var(--accent); }
  .dup { background:var(--warn-soft); color:var(--warn); border-radius:7px; padding:4px 8px; font-size:8.2pt;
    margin:4px 0 6px; }
  .link { margin-top:6px; font-size:8.8pt; font-weight:700; }
  .empty { color:var(--muted); font-size:9pt; padding:8px 0; }
  .org { font-size:9.6pt; font-weight:800; color:var(--s3); margin:12px 0 0; }
  .baseline { margin-top:20px; border-top:2px dashed var(--line); padding-top:6px; }
  table.status { width:100%; border-collapse:collapse; font-size:7.8pt; }
  table.status td, table.status th { border-bottom:1px solid var(--line); padding:3px 4px; text-align:left; }
  .ok { color:#0f8a6a; font-weight:700; } .ng { color:#c2410c; font-weight:700; }
  .footer-note { font-size:7.6pt; color:var(--muted); margin-top:14px; }
  .pb { break-before:page; }
</style>
</head>
<body>
  <section class="cover">
    <div class="kicker">WEEKLY ACCOUNTING &amp; AUDIT INSIGHT</div>
    <h1>주간 회계·감사 브리핑</h1>
    <div class="period">{{ report_date }} 발행 · 수집 기간 {{ since }} ~ {{ until }}</div>
    <div class="stats">
      {% for s in sections %}<div class="stat"><b>{{ s.arts|length }}</b><span>섹션 {{ s.no }} · {{ s.short }}</span></div>{% endfor %}
      <div class="stat"><b>{{ dup_count }}</b><span>중복 이슈</span></div>
    </div>
  </section>

  <h2 class="sec"><span class="no" style="background:var(--accent)">TOP 3</span>이번 주 핵심 이슈 브리핑</h2>
  <div class="top3">
    {% for t in top3 %}
    <div class="card">
      <div class="rank">ISSUE {{ loop.index }}</div>
      <div class="headline">{{ t.headline }}</div>
      <div class="brief">{{ t.brief }}</div>
      <div class="src">{{ t.art.location }} · <a href="{{ t.art.url }}">원문 바로가기 →</a></div>
    </div>
    {% else %}<div class="empty">이번 주 수집된 주요 이슈가 없습니다.</div>{% endfor %}
  </div>

  {% macro render_item(a) %}
  <div class="item" id="{{ a.uid }}">
    <div class="meta"><span class="tag">{{ a.source }}</span>{{ a.published or "날짜 미상" }}{% if a.via == "google_news" %} · 언론보도(Google News){% endif %}</div>
    <h3><a href="{{ a.url }}">{{ a.title }}</a></h3>
    {% if a.dup_of %}
      <div class="dup">🔁 중복: <b>{{ a.dup_of.location }}</b>의 「<a href="#{{ a.dup_of.uid }}">{{ a.dup_of.title|truncate(42) }}</a>」과 같은 이슈입니다. 요약은 해당 항목을 참고하세요.</div>
    {% else %}
      {% if a.dup_refs %}<div class="dup">🔁 관련 중복: {% for r in a.dup_refs %}<b>{{ r.location }}</b>「<a href="#{{ r.uid }}">{{ r.title|truncate(30) }}</a>」{% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
      <ul>{% for s in a.summary %}<li>{{ s }}</li>{% endfor %}</ul>
      <div class="impl"><b>감사인 시사점</b> · {{ a.implication }}</div>
    {% endif %}
    <div class="link"><a href="{{ a.url }}">원문 바로가기 →</a></div>
  </div>
  {% endmacro %}

  {% for s in sections %}
  <h2 class="sec {% if not loop.first %}{% endif %}"><span class="no" style="background:var(--s{{ s.no }})">섹션 {{ s.no }}</span>{{ s.name }}</h2>
    {% if s.no == 3 %}
      {% for org, items in s.groups %}
        <div class="org">{{ org }}</div>
        {% for a in items %}{{ render_item(a) }}{% else %}<div class="empty">최근 7일 내 관련 게시물 없음</div>{% endfor %}
      {% endfor %}
    {% else %}
      {% for a in s.arts %}{{ render_item(a) }}{% else %}<div class="empty">최근 7일 내 관련 게시물 없음</div>{% endfor %}
    {% endif %}
  {% endfor %}

  {% if baseline %}
  <div class="baseline">
    <h2 class="sec"><span class="no" style="background:#64748b">기준</span>초기 기준 게시물 (최근 {{ baseline_days }}일 주요)</h2>
    <div class="footer-note" style="margin-top:0">최초 실행이라 이번 주 이전의 주요 게시물을 모니터링 기준점으로 함께 정리했습니다. 다음 주부터는 신규 게시물만 수록됩니다.</div>
    {% for a in baseline %}{{ render_item(a) }}{% endfor %}
  </div>
  {% endif %}

  <h2 class="sec pb"><span class="no" style="background:#64748b">부록</span>수집 현황</h2>
  <table class="status">
    <tr><th>출처</th><th>상태</th><th>건수</th><th>비고</th></tr>
    {% for st in statuses %}<tr><td>{{ st.name }}</td><td class="{{ 'ok' if st.ok else 'ng' }}">{{ '정상' if st.ok else '실패' }}</td><td>{{ st.count }}</td><td>{{ st.note }}</td></tr>{% endfor %}
  </table>
  <div class="footer-note">요약 엔진: {{ engine }} · 생성 {{ generated_at }} (KST)<br>
    본 브리핑은 공개된 보도자료·게시물을 자동 수집·요약한 참고 자료입니다. 정확한 내용은 반드시 원문을 확인하세요.</div>
</body>
</html>
